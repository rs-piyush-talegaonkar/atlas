# Copy this file to .env and fill in the values.
# .env is git-ignored. Never commit a real key.

# --- Gemini via Google AI Studio ---
# Create a free key: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=

# --- GitHub ---
# Fine-grained personal access token, scoped to the repo the agent may read:
# https://github.com/settings/personal-access-tokens
# Repository permissions needed: Contents = Read-only, Metadata = Read-only
GITHUB_TOKEN=

# Default repository the agent operates on, as owner/name
GITHUB_REPO=rs-piyush-talegaonkar/atlas

# Model override. Leave unset to use gemini-3.8-flash.
ATLAS_MODEL=

# Scouts run at once. Free tier caps at 15 model requests a minute, so 1 is
# the safe default; 3 shows the fan-out throttling.
ATLAS_CONCURRENCY=1
